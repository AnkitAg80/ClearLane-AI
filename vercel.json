{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "app/app.py": {
      "includeFiles": "{src,data,config.yaml}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/app/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
